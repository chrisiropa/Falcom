<Window x:Class="ChargierwagenSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Falcom Chargierwagen-Simulator"
        Icon="Falke-Transparent.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#102A2A">
   <Window.Resources>
      <Style x:Key="Card" TargetType="Border">
         <Setter Property="Background" Value="#163B3B" />
         <Setter Property="CornerRadius" Value="10" />
         <Setter Property="Padding" Value="14" />
         <Setter Property="Margin" Value="8" />
      </Style>
      <Style x:Key="Caption" TargetType="TextBlock">
         <Setter Property="Foreground" Value="#9FD5CF" />
         <Setter Property="FontSize" Value="13" />
      </Style>
      <Style x:Key="Value" TargetType="TextBlock">
         <Setter Property="Foreground" Value="#F4FFFC" />
         <Setter Property="FontSize" Value="18" />
         <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
   </Window.Resources>

   <Grid Margin="16">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,12">
         <TextBlock x:Name="LastRefreshText"
                    DockPanel.Dock="Right"
                    Foreground="#9FD5CF"
                    VerticalAlignment="Center"
                    FontSize="14" />

         <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="Chargierwagen Simulation"
                       Foreground="#F4FFFC"
                       FontSize="30"
                       FontWeight="Bold" />
            <TextBlock Text="OPC-Verbindung, Reconnect, Event-Konfiguration und Ablauf-Log"
                       Foreground="#9FD5CF"
                       FontSize="14" />
         </StackPanel>
      </DockPanel>

      <UniformGrid Grid.Row="1" Columns="3">
         <Border Style="{StaticResource Card}">
            <Grid>
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
               </Grid.ColumnDefinitions>
               <Ellipse x:Name="OpcLamp" Width="22" Height="22" Fill="#DC2626" Margin="0,4,12,0" />
               <StackPanel Grid.Column="1">
                  <TextBlock Style="{StaticResource Caption}" Text="OPC Tani / Chargierwagen" />
                  <TextBlock x:Name="OpcStatusText" Style="{StaticResource Value}" Text="Unbekannt" />
                  <TextBlock x:Name="OpcStatusDetailText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
               </StackPanel>
            </Grid>
         </Border>

         <Border Style="{StaticResource Card}">
            <StackPanel>
               <TextBlock Style="{StaticResource Caption}" Text="Event-Konfiguration" />
               <TextBlock x:Name="EventCountText" Style="{StaticResource Value}" Text="-" />
               <TextBlock x:Name="EventDetailText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </StackPanel>
         </Border>

         <Border Style="{StaticResource Card}">
            <StackPanel>
               <TextBlock Style="{StaticResource Caption}" Text="Simulationsstatus" />
               <TextBlock x:Name="SimulationStatusText" Style="{StaticResource Value}" Text="Bereit" />
               <TextBlock x:Name="SimulationDetailText"
                          Style="{StaticResource Caption}"
                          TextWrapping="Wrap"
                          Text="Fachlogik wird spaeter ergaenzt." />
            </StackPanel>
         </Border>
      </UniformGrid>

      <TabControl Grid.Row="2"
                  Margin="0,12,0,0"
                  Background="#102A2A"
                  BorderBrush="#2E6F69"
                  Foreground="#F4FFFC">
         <TabItem Header="Ablauf">
            <Border Style="{StaticResource Card}">
               <DockPanel>
                  <TextBlock DockPanel.Dock="Top"
                             Text="Ablauf-Logging"
                             Style="{StaticResource Value}"
                             Margin="0,0,0,12" />
                  <ListBox x:Name="AblaufLogList"
                           Background="#061A1A"
                           Foreground="#F4FFFC"
                           BorderBrush="#2E6F69"
                           FontFamily="Consolas"
                           FontSize="13" />
               </DockPanel>
            </Border>
         </TabItem>
         <TabItem Header="Events">
            <Border Style="{StaticResource Card}">
               <ListBox x:Name="EventList"
                        Background="#061A1A"
                        Foreground="#F4FFFC"
                        BorderBrush="#2E6F69"
                        FontFamily="Consolas"
                        FontSize="13" />
            </Border>
         </TabItem>
      </TabControl>
   </Grid>
</Window>
